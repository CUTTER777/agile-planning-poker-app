# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# Server port (default: 3000)
PORT=3000

# Set to "production" when deploying
NODE_ENV=development

# Public base URL of the app — used to generate QR codes and invite links.
# In production, set this to your deployment URL (e.g. https://poker.example.com).
# Defaults to http://localhost:8080 when not set.
BASE_URL=

# Comma-separated list of CORS origins to allow in production.
# Required when NODE_ENV=production. Example: https://poker.example.com
ALLOWED_ORIGINS=
